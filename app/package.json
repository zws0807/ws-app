{
  "name": "flow-manifestation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright test",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "jobs:dev": "wrangler dev -c wrangler.jobs.jsonc --persist-to .wrangler/state",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium --only-shell",
    "setup:local": "node scripts/setup-local.mjs",
    "test:tools": "node --test tests/tools/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261103.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
