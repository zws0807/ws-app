{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flow-local-app",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flow-local",
      "database_id": "TODO_D1_DATABASE_ID",
      "migrations_dir": "db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_FILES",
      "bucket_name": "flow-local-private",
    },
    {
      "binding": "EXPORT_FILES",
      "bucket_name": "flow-local-exports",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_LIMITER",
        "class_name": "AuthLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthLimiter"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "flow-local-jobs",
      },
    ],
  },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 1000,
        "period": 60,
      },
    },
  ],
}
