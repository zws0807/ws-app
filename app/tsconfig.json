{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/workers-types",
      "vite/client",
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "web",
    "worker",
    "jobs",
    "shared",
    "tests",
    "*.ts"
  ]
}